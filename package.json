{
  "name": "parking-cap",
  "version": "1.0.0",
  "description": "Parking management app with real-time availability.",
  "dependencies": {
    "@cap-js/postgres": "^2",
    "@cap-js/sqlite": "^2",
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9.9.1"
  },
  "scripts": {
    "start": "cds-serve --with-mocks --in-memory",
    "start:local": "cds-serve --with-mocks --in-memory",
    "build:frontend": "cd app/parking-web && npm install && npm run build",
    "postinstall": "npm run build:frontend"
  },
  "engines": {
    "node": ">=18"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "dummy"
      },
      "db": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "database": ":memory:"
        }
      }
    }
  },
  "private": true
}
